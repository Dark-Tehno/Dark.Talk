# Dark.Talk Configuration
# Server domain for HTTP and WebSocket APIs (default: vsp210.ru)
SERVER_DOMAIN=vsp210.ru

# Application secret key for Dark-Talk-Secret-Key header
# Server validates the portion before '--'
DARK_TALK_SECRET_KEY=darktalk_secret_key_prod

# Application identifier and version for Dark-Talk-Secret-Key suffix (--<application>|<version>)
APP_CLIENT_NAME=DarkTalk
APP_CLIENT_VERSION=1.0.0

# Default client device ID
DEFAULT_DEVICE_ID=darktalk-android-client
